# Normalize line endings in the repo; check out platform-native locally.
* text=auto

# Shell scripts and systemd units must stay LF, otherwise they break on Linux.
*.sh      text eol=lf
*.service text eol=lf
*.bash    text eol=lf

# Windows launcher must stay CRLF.
*.cmd     text eol=crlf
*.bat     text eol=crlf
